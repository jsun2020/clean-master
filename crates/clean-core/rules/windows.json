{
  "pack": "windows-core",
  "rules": [
    {
      "id": "win.user_temp",
      "category": "temp",
      "risk": "safe",
      "rationale": "Per-user temporary directory; applications recreate contents as needed.",
      "base": "%TEMP%",
      "include": ["**"],
      "min_age_days": 1
    },
    {
      "id": "win.windows_temp",
      "category": "temp",
      "risk": "safe",
      "rationale": "System temporary directory; contents are disposable (may require admin rights).",
      "base": "%WINDIR%\\Temp",
      "include": ["**"],
      "min_age_days": 1
    },
    {
      "id": "browser.chrome_cache",
      "category": "cache",
      "risk": "safe",
      "rationale": "Chrome web cache; rebuilt automatically while browsing. Does not touch passwords, history or bookmarks.",
      "base": "%LOCALAPPDATA%\\Google\\Chrome\\User Data",
      "include": ["*/Cache/**", "*/Code Cache/**", "*/GPUCache/**", "*/GrShaderCache/**"],
      "min_age_days": 1
    },
    {
      "id": "browser.edge_cache",
      "category": "cache",
      "risk": "safe",
      "rationale": "Edge web cache; rebuilt automatically while browsing. Does not touch passwords, history or favorites.",
      "base": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data",
      "include": ["*/Cache/**", "*/Code Cache/**", "*/GPUCache/**", "*/GrShaderCache/**"],
      "min_age_days": 1
    },
    {
      "id": "browser.firefox_cache",
      "category": "cache",
      "risk": "safe",
      "rationale": "Firefox web cache; rebuilt automatically while browsing. Profiles, logins and bookmarks are untouched.",
      "base": "%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles",
      "include": ["*/cache2/**", "*/startupCache/**"],
      "min_age_days": 1
    },
    {
      "id": "win.thumbnail_cache",
      "category": "cache",
      "risk": "safe",
      "rationale": "Explorer thumbnail/icon caches; Windows regenerates them (files in use are skipped automatically).",
      "base": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer",
      "include": ["thumbcache_*.db", "iconcache_*.db"],
      "min_age_days": 1
    },
    {
      "id": "win.update_download_cache",
      "category": "update_leftover",
      "risk": "safe",
      "rationale": "Already-downloaded Windows Update packages; Windows re-downloads anything it still needs (may require admin rights).",
      "base": "%WINDIR%\\SoftwareDistribution\\Download",
      "include": ["**"],
      "min_age_days": 7
    },
    {
      "id": "win.user_crash_dumps",
      "category": "dumps",
      "risk": "safe",
      "rationale": "Per-user application crash dumps; only useful for debugging past crashes.",
      "base": "%LOCALAPPDATA%\\CrashDumps",
      "include": ["**"],
      "min_age_days": 0
    },
    {
      "id": "win.error_reports",
      "category": "dumps",
      "risk": "safe",
      "rationale": "Windows Error Reporting queue and archive; reports of past crashes already handled or ignored.",
      "base": "%LOCALAPPDATA%\\Microsoft\\Windows\\WER",
      "include": ["ReportQueue/**", "ReportArchive/**", "Temp/**"],
      "min_age_days": 7
    },
    {
      "id": "win.broken_shortcuts",
      "category": "broken_shortcut",
      "risk": "safe",
      "rationale": "Start Menu shortcuts whose target program no longer exists (uninstalled or moved). Only the dead .lnk is removed, never a program.",
      "base": "%APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs",
      "include": ["**/*.lnk"],
      "min_age_days": 0,
      "predicate": "broken_shortcut"
    },
    {
      "id": "win.empty_temp_folders",
      "category": "empty_folder",
      "risk": "safe",
      "rationale": "Empty leaf directories left behind in the per-user temp folder; nothing is inside them.",
      "base": "%TEMP%",
      "include": ["**"],
      "min_age_days": 1,
      "predicate": "empty_dir"
    },
    {
      "id": "win.zero_byte_temp",
      "category": "leftover",
      "risk": "safe",
      "rationale": "Zero-byte files in the per-user temp folder; empty leftovers from interrupted writes.",
      "base": "%TEMP%",
      "include": ["**"],
      "min_age_days": 1,
      "predicate": "zero_byte"
    },
    {
      "id": "trace.recent_items",
      "category": "trace",
      "risk": "safe",
      "rationale": "Recent-files list and jump lists (the 'recent documents' history). Clears the list of files you opened; the files themselves are untouched. Opt-in.",
      "base": "%APPDATA%\\Microsoft\\Windows\\Recent",
      "include": ["**"],
      "min_age_days": 0,
      "default_apply": false
    },
    {
      "id": "trace.chrome_history",
      "category": "trace",
      "risk": "safe",
      "rationale": "Chrome browsing history and visited-site lists. Does NOT remove passwords, bookmarks or logins. Opt-in; skipped while Chrome is running.",
      "base": "%LOCALAPPDATA%\\Google\\Chrome\\User Data",
      "include": ["*/History", "*/History-journal", "*/Top Sites", "*/Top Sites-journal", "*/Visited Links"],
      "min_age_days": 0,
      "default_apply": false
    },
    {
      "id": "trace.chrome_cookies",
      "category": "trace",
      "risk": "safe",
      "rationale": "Chrome cookies. Clearing these logs you out of websites. Opt-in; skipped while Chrome is running.",
      "base": "%LOCALAPPDATA%\\Google\\Chrome\\User Data",
      "include": ["*/Network/Cookies", "*/Network/Cookies-journal"],
      "min_age_days": 0,
      "default_apply": false
    },
    {
      "id": "trace.edge_history",
      "category": "trace",
      "risk": "safe",
      "rationale": "Edge browsing history and visited-site lists. Does NOT remove passwords, favorites or logins. Opt-in; skipped while Edge is running.",
      "base": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data",
      "include": ["*/History", "*/History-journal", "*/Top Sites", "*/Top Sites-journal", "*/Visited Links"],
      "min_age_days": 0,
      "default_apply": false
    },
    {
      "id": "trace.edge_cookies",
      "category": "trace",
      "risk": "safe",
      "rationale": "Edge cookies. Clearing these logs you out of websites. Opt-in; skipped while Edge is running.",
      "base": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data",
      "include": ["*/Network/Cookies", "*/Network/Cookies-journal"],
      "min_age_days": 0,
      "default_apply": false
    }
  ]
}
