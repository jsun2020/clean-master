{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clean Master",
  "version": "0.6.6",
  "identifier": "com.cleancli.cleanmaster",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clean Master",
        "width": 1160,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
